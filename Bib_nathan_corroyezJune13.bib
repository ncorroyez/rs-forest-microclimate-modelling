@article{ModelingRadiativeTransfer,
  title = {Modeling Radiative Transfer in Heterogeneous {{3D}} Vegetation Canopies},
  abstract = {The DART (Discrete Anisotropic Radiative Transfer) model simulates radiative transfer in heterogeneous 3-D scenes; here, a forest plantation. Similarly to Kimes model, the scene is divided into a rectangular cell matrix, i.e. a building block for simulating larger scenes. Cells are parallelipipedic. The scene encompasses different landscape features (i.e. trees with leaves and trunks, grass, water, soil) with specific optical (reflectance, transmittance) and structural (LAI, LAD) characteristics. Radiation directions are subdivided into contiguous sectors with possibly uneven spacing. Topography, hot spot and multiple interactions (scattering, attenuation) within cells are modeled.},
