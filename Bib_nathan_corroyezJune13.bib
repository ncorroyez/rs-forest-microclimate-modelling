  year = 2026,
  month = jun,
  journal = {ISPRS Journal of Photogrammetry and Remote Sensing},
  volume = {236},
  pages = {569--605},
  issn = {09242716},
  doi = {10.1016/j.isprsjprs.2026.04.021},
  urldate = {2026-05-05},
  abstract = {Individual tree segmentation (ITS) from LiDAR point clouds is fundamental for applications such as forest inventory, carbon monitoring and biodiversity assessment. Traditionally, ITS has been achieved with unsupervised geometry-based algorithms, while more recent advances have shifted toward supervised deep learning (DL). In the past, progress in method development was hindered by the lack of large-scale benchmark datasets, and the availability of novel data formats, particularly multispectral (MS) LiDAR, remains limited to this day, despite evidence that MS reflectance can improve the accuracy of ITS. This study introduces FGI-EMIT, the first large-scale multispectral airborne laser scanning (ALS) benchmark dataset for ITS. Captured at wavelengths 532, 905, and 1550 nm, the dataset consists of 1561 manually annotated trees from a variety of boreal forest environments, with a particular focus on small understory trees. Using FGI-EMIT, we comprehensively benchmarked four conventional unsupervised algorithms and four supervised DL approaches. Hyperparameters of unsupervised methods were optimized using a Bayesian approach, while DL models were trained from scratch. Among the unsupervised methods, Treeiso achieved the highest test set F1-score of 52.7\%. The DL approaches performed significantly better overall, with the best model, ForestFormer3D, attaining an F1score of 73.3\%. The most significant difference was observed in understory trees, where ForestFormer3D exceeded Treeiso by 25.9 percentage points. An ablation study demonstrated that, under the tested input configuration, i.e., high-density MS ALS data combined with standard input concatenation strategies, current DL-based approaches may generally fail to effectively leverage reflectance information, although single-channel reflectance can yield marginal accuracy improvements, particularly for understory trees. A performance analysis across point densities further showed that DL methods consistently remain superior to unsupervised algorithms, even at densities as low as 10 points/m2. To support future benchmarking efforts and method development, we make the FGI-EMIT dataset publicly available (https://doi.org/10.5281/zenodo.19351234).},
  langid = {english},
  file = {/home/corroyez/Zotero/storage/WEJIEILV/Ruoppa et al. - 2026 - Benchmarking individual tree segmentation using multispectral airborne laser scanning data The FGI-.pdf}
}

@misc{ruzayqatUnbiasedEstimationUsing2023,
  title = {Unbiased {{Estimation}} Using {{Underdamped Langevin Dynamics}}},
  author = {Ruzayqat, Hamza and Chada, Neil K. and Jasra, Ajay},
  year = 2023,
  month = aug,
  number = {arXiv:2206.07202},
  eprint = {2206.07202},
  primaryclass = {math, stat},
  publisher = {arXiv},
  urldate = {2024-06-11},
  abstract = {In this work we consider the unbiased estimation of expectations w.r.t. probability measures that have non-negative Lebesgue density, and which are known point-wise up-to a normalizing constant. We focus upon developing an unbiased method via the underdamped Langevin dynamics, which has proven to be popular of late due to applications in statistics and machine learning. Specifically in continuous-time, the dynamics can be constructed so that as the time goes to infinity they admit the probability of interest as a stationary measure. In many cases, time-discretized versions of the underdamped Langevin dynamics are used in practice which are run only with a fixed number of iterations. We develop a novel scheme based upon doubly randomized estimation as in [17, 19], which requires access only to timediscretized versions of the dynamics. The proposed scheme aims to remove the dicretization bias and the bias resulting from running the dynamics for a finite number of iterations. We prove, under standard assumptions, that our estimator is of finite variance and either has finite expected cost, or has finite cost with a high probability. To illustrate our theoretical findings we provide numerical experiments which verify our theory, which include challenging examples from Bayesian statistics and statistical physics.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {60J22 65C05 65C40 82C31 62G08 35Q56,Mathematics - Statistics Theory,Statistics - Computation,Statistics - Machine Learning,Statistics - Methodology},
