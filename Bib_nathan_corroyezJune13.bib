@article{bellePrinciplesPracticeExplainable2021,
  title = {Principles and {{Practice}} of {{Explainable Machine Learning}}},
  author = {Belle, Vaishak and Papantonis, Ioannis},
  year = 2021,
  month = jul,
  journal = {Frontiers in Big Data},
  volume = {4},
  pages = {688969},
  issn = {2624-909X},
  doi = {10.3389/fdata.2021.688969},
  urldate = {2024-10-07},
  abstract = {Artificial intelligence (AI) provides many opportunities to improve private and public life. Discovering patterns and structures in large troves of data in an automated manner is a core component of data science, and currently drives applications in diverse areas such as computational biology, law and finance. However, such a highly positive impact is coupled with a significant challenge: how do we understand the decisions suggested by these systems in order that we can trust them? In this report, we focus specifically on data-driven methods---machine learning (ML) and pattern recognition models in particular---so as to survey and distill the results and observations from the literature. The purpose of this report can be especially appreciated by noting that ML models are increasingly deployed in a wide range of businesses. However, with the increasing prevalence and complexity of methods, business stakeholders in the very least have a growing number of concerns about the drawbacks of models, data-specific biases, and so on. Analogously, data science practitioners are often not aware about approaches emerging from the academic literature or may struggle to appreciate the differences between different methods, so end up using industry standards such as SHAP. Here, we have undertaken a survey to help industry practitioners (but also data scientists more broadly) understand the field of explainable machine learning better and apply the right tools. Our latter sections build a narrative around a putative data scientist, and discuss how she might go about explaining her models by asking the right questions. From an organization viewpoint, after motivating the area broadly, we discuss the main developments, including the principles that allow us to study transparent models vs. opaque models, as well as model-specific or model-agnostic post-hoc explainability approaches. We also briefly reflect on deep learning models, and conclude with a discussion about future research directions.},
  langid = {english},
  file = {/home/corroyez/Zotero/storage/X3HH6XEJ/Belle and Papantonis - 2021 - Principles and Practice of Explainable Machine Lea.pdf}
}

@article{bellierInSARFlowRiemannianFlow,
  title = {{{InSARFlow}}: {{Riemannian Flow Matching}} for {{Interferometric SAR}}},
  author = {Bellier, Georges Le and Breloy, Arnaud and Audebert, Nicolas},
  abstract = {Interferometric synthetic aperture radar (InSAR) enables the analysis of topological changes in natural sites or urban areas. This technique operates by recovering the surface displacement from the study of the phase difference (interferogram) between two or multiple SAR images of the same scene at different times. In practice, the use of phase denoising algorithms is necessary to extract relevant information from the interferograms, which motivated numerous developments in the past decade. Due to the inherent periodicity of phases, interferograms can naturally be represented as points on a Riemannian manifold (specifically, the flat torus). This strong prior knowledge motivates the design of learning-based methods that respect the interferogram's intrinsic geometric constraints. Building on this observation, this paper introduces InSARFlow: a generative modeling framework for the denoising and generation of interferograms. Unlike conventional deep learning approaches formulated in Euclidean spaces, which may violate phase periodicity and produce invalid estimates, this method leveragesRiemannian flow matchingto learn distributional transports directly on the torus. The interest of this approach is demonstrated on two use cases: (1) realistic interferogram generation, in which we model the transport between uniform noise on the torus to real-world interferograms; (2) interferogram denoising, where InSARFlow transports noisy interferograms to their denoised counterparts. Extensive experiments on a controlled synthetic dataset validate the effectiveness of InSARFlow for interferogram denoising. The proposed approach consistently outperforms studied baselines, highlighting the benefits of geometry-aware learning on the torus.},
  langid = {english},
  file = {/home/corroyez/Zotero/storage/75W77LLS/Bellier et al. - InSARFlow Riemannian Flow Matching for Interferometric SAR.pdf}
}

@article{benestyImportancePearsonCorrelation2008,
  title = {On the {{Importance}} of the {{Pearson Correlation Coefficient}} in {{Noise Reduction}}},
  author = {Benesty, J. and {Jingdong Chen} and {Yiteng Huang}},
  year = 2008,
  month = may,
  journal = {IEEE Transactions on Audio, Speech, and Language Processing},
  volume = {16},
