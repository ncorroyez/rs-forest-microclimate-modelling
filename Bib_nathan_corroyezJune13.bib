@article{raupachPracticalLagrangianMethod1989,
  title = {A Practical {{Lagrangian}} Method for Relating Scalar Concentrations to Source Distributions in Vegetation Canopies},
  author = {Raupach, M. R.},
  year = 1989,
  month = apr,
  journal = {Quarterly Journal of the Royal Meteorological Society},
