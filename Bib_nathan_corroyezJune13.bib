@article{verhoefEarthObservationModel,
  title = {Earth Observation Model Sensitivity Analysis to Assess Mission Performances in Terms of Geo-Biophysical Variable Retrieval Accuracies},
  author = {Verhoef, Wout},
  abstract = {An integrated soil-leaf-canopy radiative transfer model called SLC has been coupled with MODTRAN4 effective parameters describing the atmosphere in order to simulate hyperspectral (201 bands) multi-angular (7 directions) top-of-atmosphere radiance observations of the earth's surface. The SLC model consists of a modified version of Hapke's soil BRDF model, the PROSPECT leaf optical properties model and a numerically robust 2-layer canopy radiative transfer model called 4SAIL2. The canopy model accommodates a vertical leaf color gradient and crown clumping such as in forests. It is speedoptimized and numerically stable by interception of singularities. The combined model has been applied in a comprehensive sensitivity analysis in order to assess the accuracy of geo-biophysical variable retrievals from topof-atmosphere radiance data acquired by several hypothetical remote sensing missions with various spectral, directional and instrumental (noise) characteristics. The developed method allows to diagnose a possible illposedness of the model inversion by singular value decomposition (SVD) of the Jacobian matrix, which contains the partial derivatives of the combined model with respect to all relevant soil-leaf-canopy model input parameters. By taking proper account of available a priori information, realistic (Bayesian) estimates of variable retrieval accuracies have been obtained. This feature can also be used to formulate a more stable Gauss-Newton model inversion updating rule by a proper balancing of remotely sensed data against existing knowledge. From the results it appears that hyperspectral multi-angular missions would provide orders-of-magnitude more accurate retrievals than multispectral monodirectional missions would. As expected, the multi-angular aspect is essential for the successful retrieval of canopy architecture, whereas the hyperspectral aspect is crucial for the accurate retrieval of leaf properties such as the chlorophyll and water contents.},
  langid = {english},
  file = {/home/corroyez/Zotero/storage/Q4WS8W33/Verhoef_Earth observation model sensitivity analysis to assess mission performances in.pdf}
}

