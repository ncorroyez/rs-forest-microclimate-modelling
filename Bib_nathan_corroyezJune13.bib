@article{hesProjectingFutureForest2024,
  title = {Projecting Future Forest Microclimate Using a Land Surface Model},
  author = {Hes, Gabriel and Vanderkelen, Inne and Fisher, Rosie and Chave, J{\'e}r{\^o}me and Og{\'e}e, J{\'e}r{\^o}me and L Davin, Edouard},
