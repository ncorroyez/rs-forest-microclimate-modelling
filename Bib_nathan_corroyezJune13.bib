@article{jamaliSwinTransformerDeep2022,
  title = {Swin {{Transformer}} and {{Deep Convolutional Neural Networks}} for {{Coastal Wetland Classification Using Sentinel-1}}, {{Sentinel-2}}, and {{LiDAR Data}}},
  author = {Jamali, Ali and Mahdianpari, Masoud},
  year = 2022,
  month = jan,
  journal = {Remote Sensing},
  volume = {14},
