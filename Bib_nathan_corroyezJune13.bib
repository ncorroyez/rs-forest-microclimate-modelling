@article{breda1_GroundbasedMeasurementsLeaf2003,
  title = {1\_{{Ground-based}} Measurements of Leaf Area Index: A Review of Methods, Instruments and Current Controversies},
  shorttitle = {Ground-Based Measurements of Leaf Area Index},
  author = {Breda, N. J. J.},
  year = 2003,
