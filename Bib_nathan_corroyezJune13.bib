@article{kramerSARSatelliteOrbit2026,
  title = {{{SAR}} Satellite Orbit Design for Visibility-Optimal Coverage},
  author = {Kramer, Evan L. and Miller, David W.},
  year = 2026,
  month = jan,
  journal = {Acta Astronautica},
  volume = {238},
  pages = {12--24},
  issn = {00945765},
  doi = {10.1016/j.actaastro.2025.07.043},
  urldate = {2025-10-21},
  abstract = {Presently, governments or large corporations can choose to invest in the development and operation of synthetic aperture radar (SAR) satellites to monitor a predefined set of target locations with desired observation characteristics. Historically, observation characteristics primarily pertained to the temporal sampling resolution of high-interest targets and the geometric consistency of observations. However, given the reduction in competing stakeholder interests afforded by satellite ownership, other observation characteristics can be considered in the orbit design process that further improve the quality of collected data. To this end, this work considers the presence of geometric distortions during the orbit design process. Accounting for geometric distortions is important since their presence constitutes a loss of information in the collected image. The presence of geometric distortions within a region of interest (ROI) can be reduced by controlling the relative orientation between the satellite's viewing geometry and illuminated topography. Using recent advancements in SAR observation planning for visibility-challenging terrain, this work develops an orbit design process for low Earth orbit (LEO) repeat ground track (RGT) orbits that reduce the presence of geometric distortions. A metaheuristic optimization approach is used to optimize the right ascension of the ascending node (RAAN) over the entire range of inclination angles to maximize the average visibility of one, or multiple, targets. General trends in average visibility as a function of inclination angle are presented for a single target case. Then, key points are presented for considering multiple targets with similar and dissimilar visibility distributions. The presented results show the first explicit incorporation of ROI visibility into the SAR orbit design process and demonstrate the resulting improvement in data quality.},
  langid = {english},
  file = {/home/corroyez/Zotero/storage/NCAVEUB5/Kramer and Miller - 2026 - SAR satellite orbit design for visibility-optimal coverage.pdf}
}

@article{kronerDisentanglingCompetitionLight2026,
  title = {Disentangling Competition for Light from Remaining Competition Aspects in {{European}} Beech Forests},
  author = {Kr{\"o}ner, Katja and Stangler, Dominik Florian and Larysch, Elena and Haberstroh, Simon and Schliephack, Paul Melchior and {Braun-Wimmer}, Joshua and Seifert, Thomas and Frey, Julian},
  year = 2026,
  month = feb,
  journal = {Forest Ecology and Management},
  volume = {601},
  pages = {123356},
  issn = {03781127},
  doi = {10.1016/j.foreco.2025.123356},
  urldate = {2026-01-26},
  abstract = {European beech forests face increasing environmental stress and anthropogenic demands, necessitating an understanding of tree growth and forest ecosystem dynamics to ensure future productivity and stability. Key to this is the disentangling of tree competition for light and edaphic resources to identify growth-limiting factors under different conditions. In this study, we aimed to disentangle the impact of light availability and further aspects of competition on the radial growth of 943 European beech trees across six research sites in Southwest Germany. Using a novel approach combining Terrestrial Laser Scanning and Radiative Transfer Modelling, we conducted a detailed, spatially explicit assessment of potential annual light availability per individual tree, shaped by complex local structures. We compared the predictive importance of light availability on tree growth against common competition indices by contrasting their predictions of basal area increment measurements using Generalized Additive Models. This offered the unique possibility to investigate shifts in importance of competition aspects across annual drought intensities. We observed a positive influence of light availability on general growth levels of European beech (R2 = 0.67), with a saturation effect at higher light levels. The spatially modelled light availability outperformed a common shading-focussed index (R2 = 0.47) in describing general growth levels but was explaining less variability than a competition index incorporating both edaphic and light competition (R2 = 0.72). As expected, the light availability gained relative predictive importance compared to remaining competition for water and nutrients under more humid conditions. Overall, the proposed spatial assessment proved useful to disentangle the competition for light from remaining competition, offering valuable insights for studying, understanding, and modelling competition dynamics.},
  langid = {english},
  file = {/home/corroyez/Zotero/storage/85AMDZ7B/1-s2.0-S0378112725008643-main.pdf}
}

@article{kucharikMeasurementsBranchArea1998,
