}

@article{putzenlechnerAccuracyAssessmentLAI2024a,
  title = {Accuracy Assessment of {{LAI}}, {{PAI}} and {{FCOVER}} from {{Sentinel-2}} and {{GEDI}} for Monitoring Forests and Their Disturbance in {{Central Germany}}},
  author = {Putzenlechner, Birgitta and Bevern, Felix and Koal, Philipp and Grieger, Simon and Kappas, Martin and Koukal, Tatjana and L{\"o}w, Markus and Filipponi, Federico},
  year = 2024,
