@article{sohrabiCanopyHeightMapping2026,
  title = {Canopy Height Mapping in Complex Temperate Forests Using Spaceborne {{GEDI LiDAR}} and Multitemporal {{Sentinel-2}} Data},
  author = {Sohrabi, Hormoz and Zeinali Yadegari, Laya and Quir{\'o}s, Elia and Immitzer, Markus},
  year = 2026,
  month = aug,
  journal = {Smart Agricultural Technology},
  volume = {14},
  pages = {102249},
  issn = {27723755},
  doi = {10.1016/j.atech.2026.102249},
  urldate = {2026-08-12},
  abstract = {Forests with complex canopy structures pose significant challenges for accurate canopy height estimation, which is essential for carbon monitoring, conservation planning, and sustainable forest management. This study integrates multitemporal Sentinel-2 imagery and spaceborne GEDI LiDAR data using a random forest regression model to generate a high-resolution canopy height map for over two million hectares of structurally complex temperate forest. Model performance was evaluated using 2543 national forest inventory plots with corrected geolocation to address spatial misalignment. Results show that multi-temporal Sentinel-2 composites significantly improved GEDI relative heights predictions compared to single-season inputs, increasing R{$^2$} from 0.12 to 0.22 to 0.26--0.28. ALSO, GEDI quality filtering increased R{$^2$} of multi-temporal models to 0.53--0.56. Spring and summer imagery contributed most to model accuracy due to enhanced vegetation activity and stronger spectral contrast during peak growing seasons. A novel geolocation correction approach based on a high-resolution canopy height model derived from a foundation model (Meta CHM) was implemented to adjust field plot locations in the absence of airborne LiDAR data. This method, based on a search radius to identify the best match between field-measured heights and Meta CHM values, substantially improved model performance, increasing R{$^2$} from 0.12 to 0.21 to 0.21--0.45. Error analysis revealed that the model tends to underestimate higher canopy height values, likely due to spectral saturation in dense and highly stratified stands. Comparisons with existing global canopy height products showed that the locally calibrated model better captured structural variability, particularly in complex and multi-layered forests. By integrating seasonal spectral information and improving spatial alignment of reference data, this approach provides a practical and scalable framework for canopy height estimation in data-scarce regions, particularly where airborne LiDAR data are not available.},
  langid = {english},
  file = {/home/corroyez/Zotero/storage/WB8C2YYC/Sohrabi et al. - 2026 - Canopy height mapping in complex temperate forests using spaceborne GEDI LiDAR and multitemporal Sen.pdf}
}

@article{sohrabiIntegratingSatelliteEmbeddings2026,
  title = {Integrating Satellite Embeddings and National Forest Inventory Data to Map Above-Ground Biomass of Temperate Deciduous Old-Growth Forests},
  author = {Sohrabi, Hormoz},
  year = 2026,
  month = jun,
  journal = {Advances in Space Research},
  volume = {77},
  number = {12},
  pages = {11837--11850},
  issn = {02731177},
  doi = {10.1016/j.asr.2026.04.018},
  urldate = {2026-08-12},
  abstract = {Accurate estimation of above-ground biomass (AGB) is fundamental for understanding carbon dynamics, assessing forest health, and guiding conservation strategies. However, mapping AGB in structurally complex old-growth forests remains challenging due to limitations in remote sensing data and modeling approaches. This study presents the first evaluation of the newly released AlphaEarth Foundation (AEF) embeddings (a global, analysis-ready dataset derived from multimodal Earth observation sources) for AGB estimation. Using 2543 field plots from the Hyrcanian forests of northern Iran, six machine learning algorithms (MLs), Random Forest (RF), Extreme Gradient Boosting (XGBoost), Support Vector Regression (SVR), k-Nearest Neighbors (KNN), Linear Regression (LR), and Artificial Neural Networks (ANN) were evaluated, together with a weighted ensemble approach. The correction of plot locations using a canopy height model derived from Meta AI models significantly reduced geolocation bias, underscoring the importance of spatial alignment between field and satellite data. Feature importance analysis showed that a subset of layers strongly contributed to predictive power. Across algorithms, non-linear models slightly outperformed linear methods, with XGBoost and ANN achieving the highest accuracies (R2 {$\approx$} 0.63 after geolocation correction). Ensemble modeling further improved prediction robustness (R2 {$\approx$} 0.71), reducing error metrics and producing spatially consistent AGB maps at 10 m resolution. These findings highlight the value of AEF embeddings as a novel feature set for AGB mapping in complex forest ecosystems. This work demonstrates how foundation models, combined with ensemble learning, can support high-resolution, scalable AGB monitoring and provide essential tools for forest management, carbon accounting, and biodiversity conservation.},
  langid = {english},
  file = {/home/corroyez/Zotero/storage/XS7CL9IU/Sohrabi - 2026 - Integrating satellite embeddings and national forest inventory data to map above-ground biomass of t.pdf}
}

@article{sohrabiModelingStructuralAttributes2026,
