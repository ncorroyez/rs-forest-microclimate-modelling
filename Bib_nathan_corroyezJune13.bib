@article{raddiMonitoringDroughtResponse2022,
  title = {Monitoring Drought Response and Chlorophyll Content in {{Quercus}} by Consumer-Grade, near-Infrared ({{NIR}}) Camera: A Comparison with Reflectance Spectroscopy},
  shorttitle = {Monitoring Drought Response and Chlorophyll Content in {{Quercus}} by Consumer-Grade, near-Infrared ({{NIR}}) Camera},
  author = {Raddi, Sabrina and Giannetti, Francesca and Martini, Sofia and Farinella, Fabio and Chirici, Gherardo and Tani, Andrea and Maltoni, Alberto and Mariotti, Barbara},
  year = 2022,
