@article{shabanovEffectFoliageSpatial2003,
  title = {Effect of Foliage Spatial Heterogeneity in the {{MODIS LAI}} and {{FPAR}} Algorithm over Broadleaf Forests},
  author = {Shabanov, N.V. and Wang, Y. and Buermann, W. and Dong, J. and Hoffman, S. and Smith, G.R. and Tian, Y. and Knyazikhin, Y. and Myneni, R.B.},
