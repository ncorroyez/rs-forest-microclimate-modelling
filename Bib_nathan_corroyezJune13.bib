@article{ednieMicroclimaticSpeciesspecificThermal2026,
  title = {Microclimatic and Species-Specific Thermal Extremes Limit Butterfly Patch Use in a Protected Ecosystem},
  author = {Ednie, Gabrielle and Kerr, Jeremy T.},
  year = 2026,
  month = aug,
  journal = {Basic and Applied Ecology},
  pages = {S1439179126000587},
  issn = {14391791},
  doi = {10.1016/j.baae.2026.08.004},
  urldate = {2026-09-10},
  abstract = {Globally, many species have altered their ranges as environmental conditions exceed the boundaries of their realized thermal niches. Models using continental-scale occurrence and temperature data can predict these shifts at broad extents, but predictions remain highly uncertain within and among individual habitats. Here, we use high resolution drone-based remote sensing to test whether species-specific extreme temperatures help predict butterfly patch use, and whether realized thermal niche limits inform local habitat use as they do continental patterns. We mapped air temperature at 5 cm resolution and vegetation height at 1 cm resolution across 15 patches in an eastern Ontario alvar ecosystem, extracted indices of landscape heterogeneity, humidity, and species-specific thermal extremes, and surveyed butterfly communities. Using generalized linear mixed models, we found that patch humidity and floral richness were the strongest predictors of species- and community-level patch use, respectively, yet thermal extremes contributed independently and significantly across all models despite this dominance. Fine-scale thermal extremes outperformed regional air temperature in predicting species occurrence and abundance, while the reverse held for community-level richness and diversity, indicating that the appropriate scale of thermal measurement depends on the ecological process under study. Thermal extremes also revealed a hidden area effect, whereby functionally usable habitat was reduced below what vegetation-based assessments alone suggest, with occurrence dropping sharply once a substantial portion of a patch exceeded thermal tolerance limits. These results demonstrate that realized thermal niche principles remain ecologically meaningful at the patch scale, provided thermal data are captured at sufficient resolution. Predicting species abundance and occurrence within habitats will therefore require considering both resource availability and species-appropriate thermal scales, complementing traditional landscape metrics of habitat extent and connectivity.},
  langid = {english},
  file = {/home/corroyez/Zotero/storage/2B7C59YJ/Ednie and Kerr - 2026 - Microclimatic and species-specific thermal extremes limit butterfly patch use in a protected ecosyst.pdf}
}

@article{ehbrechtEffectsStructuralHeterogeneity2019,
  title = {Effects of Structural Heterogeneity on the Diurnal Temperature Range in Temperate Forest Ecosystems},
  author = {Ehbrecht, Martin and Schall, Peter and Ammer, Christian and Fischer, Markus and Seidel, Dominik},
  year = 2019,
  month = jan,
  journal = {Forest Ecology and Management},
  volume = {432},
  pages = {860--867},
  issn = {03781127},
  doi = {10.1016/j.foreco.2018.10.008},
  urldate = {2026-03-17},
  abstract = {The microclimate in forest ecosystems can be altered by modifications of stand structure due to forest management or natural forest development. Current forest management practices in Central Europe and North America aim to promote structural heterogeneity and maintain forest canopy cover, which is known to be a major driver of forest microclimate. Here, we investigated the impacts of forest management and structural heterogeneity on the diurnal temperature range (DTR) in 128 managed forest stands in three climatically different locations (Swabian Alb, Hainich-D\"un and Schorfheide-Chorin) in Central Europe. Increasing structural heterogeneity by promoting tree size diversity and differentiation increased vertical stratification and resulted in an impaired DTR during the vegetation period. Linear regression models with geographic location, elevation above sea level, canopy openness and measures of structural heterogeneity as explanatory variables explained 79.4--80.9\% of variance in DTR. However, the overall effect of structural heterogeneity on DTR was small. Differences in DTR between plots of different main tree species could be attributed to differences in canopy openness and light transmission, whereas tree species diversity had no significant effect on DTR. Unmanaged forests were characterized by a significantly lower DTR than managed, even-aged forests. DTR in uneven-aged stands managed under single tree selection was comparable to unmanaged stands. Terrestrial laser scanning (TLS) derived measures of canopy openness and vertical structure allowed to explain 79.4\% of variance in DTR considering geographic location and elevation, which can also be assessed by TLS with integrated GPS and an altimeter. We conclude that structural characteristics of forest stands other than canopy openness contribute marginally to variation in forest microclimate. However, the analyses of structure-microclimate analyses indicate that effects of stand structure on DTR might be more pronounced in regions with low precipitation during the vegetation period.},
  langid = {english},
  file = {/home/corroyez/Zotero/storage/DZ7F77N6/Ehbrecht et al. - 2019 - Effects of structural heterogeneity on the diurnal temperature range in temperate forest ecosystems.pdf}
}

@article{ehbrechtQuantifyingStandStructural2017,
  title = {Quantifying Stand Structural Complexity and Its Relationship with Forest Management, Tree Species Diversity and Microclimate},
  author = {Ehbrecht, Martin and Schall, Peter and Ammer, Christian and Seidel, Dominik},
  year = 2017,
  month = aug,
  journal = {Agricultural and Forest Meteorology},
  volume = {242},
  pages = {1--9},
  issn = {01681923},
  doi = {10.1016/j.agrformet.2017.04.012},
  urldate = {2026-03-17},
  abstract = {Measures to describe stand structural complexity efficiently and objectively are increasingly demanded to understand the relationship between forest management, stand structure, biodiversity and ecosystem functioning. Here, we present an approach to quantify stand structural complexity based on fractal dimension derived from single terrestrial laser scans (TLS) that were made on 126 permanent forest research plots in Germany, representing major stand and management types. The newly developed SSC-index (SSCI) was positively correlated to conventional tree-based measures of stand structural complexity, tree size differentiation, diversity of tree diameters and random tree spacing patterns. Beyond that, it successfully differentiated between stand types of different main tree species and management systems. SSCI increased from low to high tree species diversity and explained microclimatic fluctuations better than conventional, tree-based measures. Given the high efficiency during data collection, TLS can be used to assess stand structural complexity for large sample sizes to provide an explanatory variable for the effects of forest management on biodiversity, productivity and ecosystem processes.},
  langid = {english},
  file = {/home/corroyez/Zotero/storage/BSEAJRM8/Ehbrecht et al. - 2017 - Quantifying stand structural complexity and its relationship with forest management, tree species di.pdf}
}

@misc{eigenLearningFactoredRepresentations2014,
  title = {Learning {{Factored Representations}} in a {{Deep Mixture}} of {{Experts}}},
  author = {Eigen, David and Ranzato, Marc'Aurelio and Sutskever, Ilya},
