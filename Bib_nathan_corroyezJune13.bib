@misc{klotzEvaluatingInterpretabilitySparse2026,
  title = {Evaluating the {{Interpretability}} of {{Sparse Autoencoders}} with {{Concept Annotations}}},
  author = {Klotz, Jonas and Dantas, Cassio F. and Jain, Pallavi and Marcos, Diego and Demir, Beg{\"u}m},
  year = 2026,
