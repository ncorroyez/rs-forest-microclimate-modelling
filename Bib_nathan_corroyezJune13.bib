@article{westEffectTreeShelters1999,
  title = {Effect of {{Tree Shelters}} on {{Survival}}, {{Growth}}, and {{Wood Quality}} of 11 {{Tree Species Commonly Planted}} in the {{Southern United States}}},
  author = {West, David and Chappelka, Arthur and Tilt, Kenneth and Ponder, Harry and Williams, J. David},
  year = 1999,
