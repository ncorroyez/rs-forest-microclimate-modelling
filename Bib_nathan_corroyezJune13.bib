}

@article{jamilModelingMarshallStability2025,
  title = {Modeling of {{Marshall Stability}} of Plastic-Reinforced Asphalt Concrete Using Machine Learning Algorithms and {{SHAP}}},
  author = {Jamil, Mahmudul Haque and Jagirdar, Ravi and Kashem, Abul and Ali, Md Nimar and Deb, Dipongkar},
