@article{pardiniEarlyLessonsCombining2019,
  title = {Early {{Lessons}} on {{Combining Lidar}} and {{Multi-baseline SAR Measurements}} for {{Forest Structure Characterization}}},
  author = {Pardini, Matteo and Armston, John and Qi, Wenlu and Lee, Seung Kuk and Tello, Marivi and Cazcarra Bes, Victor and Choi, Changhyun and Papathanassiou, Konstantinos P. and Dubayah, Ralph O. and Fatoyinbo, Lola E.},
  year = 2019,
