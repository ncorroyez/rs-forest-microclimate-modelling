@article{hosoiVoxelBased3DModeling2006,
  title = {Voxel-{{Based}} 3-{{D Modeling}} of {{Individual Trees}} for {{Estimating Leaf Area Density Using High-Resolution Portable Scanning Lidar}}},
  author = {Hosoi, Fumiki and Omasa, Kenji},
  year = 2006,
