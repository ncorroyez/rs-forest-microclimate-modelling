@article{yangLeafAngleLeaf2023,
  title = {Leaf Angle as a Leaf and Canopy Trait: {{Rejuvenating}} Its Role in Ecology with New Technology},
  shorttitle = {Leaf Angle as a Leaf and Canopy Trait},
  author = {Yang, Xi and Li, Rong and Jablonski, Andrew and Stovall, Atticus and Kim, Jongmin and Yi, Koong and Ma, Yixin and Beverly, Daniel and Phillips, Richard and Novick, Kim and Xu, Xiangtao and Lerdau, Manuel},
  year = 2023,
