@article{wingateStrongSeasonalDisequilibrium2010,
  title = {Strong Seasonal Disequilibrium Measured between the Oxygen Isotope Signals of Leaf and Soil {{CO}}{\textsubscript{2}} Exchange},
  author = {Wingate, Lisa and Og{\'e}e, J{\'e}r{\^o}me and Burlett, R{\'e}gis and Bosc, Alexandre},
