}

@article{ruzickovaContextDependentMovementResponses2026,
  title = {Context-{{Dependent Movement Responses}} of {{Large Carabids}} to {{Forest Gap Cuttings}}},
  author = {R{\r u}{\v z}i{\v c}kov{\'a}, Jana and Sz{\'e}kely, {\'A}ron and {\'O}dor, P{\'e}ter and Elek, Zolt{\'a}n},
