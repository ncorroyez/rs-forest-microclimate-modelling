  abstract = {Current large-scale satellite-based forest disturbance monitoring systems operate at 10--30 m resolution, which is too coarse to detect changes at the scale of individual trees resulting in a systematic underestimation of forest dis turbances. Here, we introduce FORMSpoT (Forest Mapping with SPOT Time series), a decade-long (2014-2024), country-scale mapping of forest canopy height at 1.5 m resolution over France, together with FORMSpoT-{$\Delta$}, annual disturbance polygons derived from height differences in the FORMSpoT time series.},
