  pages = {9536},
  issn = {2041-1723},
  doi = {10.1038/s41467-025-64580-y},
  urldate = {2025-12-04},
  abstract = {Abstract             The climate effectiveness of forestation in Europe is debated, as it may provide more warming via solar energy absorption than evaporative cooling. Since forests play an important role in European climate policy, it is necessary to explore potential solutions to this issue in a warmer world. Here, based on experiments conducted with a regional climate model under several forest change scenarios, we find that conversion from coniferous to broadleaved trees in currently forested areas can provide cooling for summer hot extremes (e.g., reducing the monthly mean daily maximum temperature in July over Continental Europe by 0.6 {$^\circ$}C). The conversion can also mitigate the undesired warming impacts of forestation with present-day forest composition in most of Europe, e.g., reversing effects on the monthly mean daily maximum temperature in July over Continental Europe from +0.3 {$^\circ$}C to -0.7 {$^\circ$}C. This study highlights the importance of considering tree species in European forest policy development and suggests that the Northern and Central regions should be prioritised for forestation over the Western and Southern parts.},
  langid = {english},
  file = {/home/corroyez/Zotero/storage/FHMQJR4H/Yao et al. - 2025 - Conversion from coniferous to broadleaved trees can make European forests more climate-effective.pdf}
}

@article{yiCanopyStructuralDiversity2026,
  title = {Canopy Structural Diversity Mediates the Effect of Climate on Primary Productivity in Forests},
  author = {Yi, Xiaoxia and Vincent, Gr{\'e}goire and Hu, Tianyu and Liu, Jianli and Lutz, James A. and Ren, Haibao and Chen, Lei and Burslem, David F. R. P. and Birch, Joseph D. and Cao, Min and Dalling, James W. and Coomes, David A. and Derroire, G{\'e}raldine and Du, Hu and Fang, Shuai and Jin, Guangze and Li, Jinbo and Lin, Fei and Ni, Hongwei and O'Brien, Michael J. and Shen, Guochun and Wang, Xihua and Wang, Xingyu and Yang, Jie and Zeng, Fuping and Zhu, Daoguang and Zhu, Yan and Su, Yanjun and Guo, Qinghua and Ma, Keping and Mi, Xiangcheng},
