@article{verrelstSpectralBandSelection2016,
  title = {Spectral Band Selection for Vegetation Properties Retrieval Using {{Gaussian}} Processes Regression},
  author = {Verrelst, Jochem and Rivera, Juan Pablo and Gitelson, Anatoly and Delegido, Jesus and Moreno, Jos{\'e} and {Camps-Valls}, Gustau},
  year = 2016,
  month = oct,
  journal = {International Journal of Applied Earth Observation and Geoinformation},
  volume = {52},
  eprint = {2012.08640},
  primaryclass = {cs, eess, stat},
  pages = {554--567},
  issn = {15698432},
  doi = {10.1016/j.jag.2016.07.016},
  urldate = {2023-10-12},
  abstract = {With current and upcoming imaging spectrometers, automated band analysis techniques are needed to enable efficient identification of most informative bands to facilitate optimized processing of spectral data into estimates of biophysical variables. This paper introduces an automated spectral band analysis tool (BAT) based on Gaussian processes regression (GPR) for the spectral analysis of vegetation properties. The GPR-BAT procedure sequentially backwards removes the least contributing band in the regression model for a given variable until only one band is kept. GPR-BAT is implemented within the framework of the free ARTMO's MLRA (machine learning regression algorithms) toolbox, which is dedicated to the transforming of optical remote sensing images into biophysical products. GPR-BAT allows (1) to identify the most informative bands in relating spectral data to a biophysical variable, and (2) to find the least number of bands that preserve optimized accurate predictions. This study concludes that a wise band selection of hyperspectral data is strictly required for optimal vegetation properties mapping.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Computer Vision and Pattern Recognition,Electrical Engineering and Systems Science - Image and Video Processing,Statistics - Applications},
  file = {/home/corroyez/Zotero/storage/DS63BMEN/Verrelst et al_2016_Spectral band selection for vegetation properties retrieval using Gaussian.pdf}
}

@misc{viguesjorbaVerticalDistributionPrey2026,
  title = {Vertical Distribution of Prey and Vegetation Structure Shape Bat and Ground-Dwelling Mammal Activity in a Temperate Forest},
  author = {Vigu{\'e}s Jorba, Jan and Bollmann, K. and Cordeiro Pereira, Joao and Strozzega, Ayla and Luc{\'i}a, Villarroya-Villalba and K{\"u}kenbrink, Daniel and Scherrer, Daniel and Gossner, Martin and Braunisch, Veronika and Hendel, Anna-Lena},
  year = 2026,
  month = sep,
  doi = {10.22541/authorea.15008172/v1},
  urldate = {2026-09-10},
  abstract = {Vertical structural complexity shapes resource availability throughout forest ecosystems. However, how mobile consumers respond to this variation across the vertical profile remains poorly understood, particularly for taxonomic groups differing in their ability to access different vertical layers. In this study, we examine how the activity of flying and ground-dwelling small mammals respond to resource distribution and stand structure across the vertical forest profile. We combined paired acoustic bat surveys conducted in the canopy and understorey with ground-based camera trap surveys of small, ground-dwelling mammals, alongside layerspecific measurements of invertebrate prey abundance and LiDAR-derived vegetation structure. Bat activity varied across the vertical profile in line with known foraging ecomorphology; open and edge-foraging specialists were more frequently detected in the canopy, while forestinterior foraging species were more frequently detected in the understorey. Across mammal taxonomic groups, dietary specialists tracked invertebrate abundance independently of vertical layer, whereas dietary generalists showed no relationship to prey abundance. This suggests that trophic specialisation, rather than locomotion mode, determines the strength of bottomup coupling between invertebrates and their mammalian predators. In contrast, the structural drivers of activity differed strongly between the two taxonomic groups and vertical layers, indicating that structural niche partitioning does not follow the same rules as trophic coupling. Bat activity showed a clutter-versus-resource trade-off and ground-level structural conditions shaped ground-dwelling mammal activity more strongly than canopy-associated attributes. These results show that structural niche partitioning in forest consumer communities is determined by taxon-specific structural characteristics rather than by a single common gradient of habitat quality. Vertically explicit sampling designs are therefore essential to avoid incomplete inference about the environmental drivers of activity, especially for canopy-associated species.},
  langid = {english},
  file = {/home/corroyez/Zotero/storage/5VEL9DRN/Vigués Jorba et al. - 2026 - Vertical distribution of prey and vegetation structure shape bat and ground-dwelling mammal activity.pdf}
}

