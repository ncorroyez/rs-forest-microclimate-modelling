@article{vandertolIntegratedModelSoilcanopy2009,
  title = {An Integrated Model of Soil-Canopy Spectral Radiances, Photosynthesis, Fluorescence, Temperature and Energy Balance},
  author = {Van Der Tol, C. and Verhoef, W. and Timmermans, J. and Verhoef, A. and Su, Z.},
  year = 2009,
