  langid = {english},
  file = {/home/corroyez/Zotero/storage/HNTENZX8/Kötz et al. - 2004 - Radiative transfer modeling within a heterogeneous canopy for estimation of forest fire fuel propert.pdf}
}

@article{koukoulasQuantifyingSpatialProperties2004,
  title = {Quantifying the Spatial Properties of Forest Canopy Gaps Using {{LiDAR}} Imagery and {{GIS}}},
  author = {Koukoulas, S. and Blackburn, G. A.},
