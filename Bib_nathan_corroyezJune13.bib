@article{garriguesIntercomparisonSensitivityAnalysis2008,
  title = {Intercomparison and Sensitivity Analysis of {{Leaf Area Index}} Retrievals from {{LAI-2000}}, {{AccuPAR}}, and Digital Hemispherical Photography over Croplands},
