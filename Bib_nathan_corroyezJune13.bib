@inproceedings{doussRegressionAnalysesStudy2020,
  title = {Regression Analyses to Study the Benefit of {{Sentinel}} and {{LIDAR}} Data Fusion for Forest Structure},
  booktitle = {2020 {{Mediterranean}} and {{Middle-East Geoscience}} and {{Remote Sensing Symposium}} ({{M2GARSS}})},
