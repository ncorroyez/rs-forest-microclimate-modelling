@article{feretOptimizingSpectralIndices2011,
  title = {Optimizing Spectral Indices and Chemometric Analysis of Leaf Chemical Properties Using Radiative Transfer Modeling},
  author = {F{\'e}ret, Jean-Baptiste and Fran{\c c}ois, Christophe and Gitelson, Anatoly and Asner, Gregory P. and Barry, Karen M. and Panigada, Cinzia and Richardson, Andrew D. and Jacquemoud, St{\'e}phane},
