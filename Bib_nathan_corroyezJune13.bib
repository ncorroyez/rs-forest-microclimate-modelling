@article{besicUsingStructuralClass2024,
  title = {Using {{Structural Class Pairing}} to {{Address}} the {{Spatial Mismatch Between GEDI Measurements}} and {{NFI Plots}}},
  author = {Besic, Nikola and Durrieu, Sylvie and Schleich, Anouk and Vega, C{\'e}dric},
  year = 2024,
