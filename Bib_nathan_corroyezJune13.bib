@article{kearneyMethodComputingHourly2020,
  title = {A Method for Computing Hourly, Historical, Terrain-corrected Microclimate Anywhere on Earth},
  author = {Kearney, Michael R. and Gillingham, Phillipa K. and Bramer, Isobel and Duffy, James P. and Maclean, Ilya M.D.},
