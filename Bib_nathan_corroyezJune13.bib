  author = {Banskota, Asim and Serbin, Shawn P. and Wynne, Randolph H. and Thomas, Valerie A. and Falkowski, Michael J. and Kayastha, Nilam and {Gastellu-Etchegorry}, Jean-Philippe and Townsend, Philip A.},
  year = 2015,
  month = jun,
  journal = {IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
