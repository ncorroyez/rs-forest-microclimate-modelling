// Figure 2 — Chapter 1 analysis pipeline.
//
// Rendered by scripts/c1_fig2_methodo.R (graphviz `dot`). This figure used to be a
// hand-made PNG with no source, and it had drifted from the analysis it depicts:
// it said "LiDAR traits (10 m)" where the pipeline is native 20 m, and "±1 SD
// perturbation" for the design that was replaced by fixed native steps. Both are
// corrected here, and the figure now matches its own caption.
// The terminal conclusion node was REMOVED 2026-08-01. Figure 2 is a Methods
// schematic; stating the chapter's finding in it put a result in the Methods, and it
// is the element that drifts when the finding is refined (it still read "vertical
// profile negligible" after the framing moved to "potent but unrealized"). The
// caption never described it either. The conclusion belongs in Sections 4 and 5.
digraph methodo {
  graph [fontname="DejaVu Sans", bgcolor="white", rankdir=TB, splines=polyline,
         nodesep=0.45, ranksep=0.70, compound=true];
  node  [fontname="DejaVu Sans", shape=box, style="filled", penwidth=1.2,
         margin="0.22,0.14", fontsize=15, color="#BBBBBB"];
  edge  [color="#9A9A9A", penwidth=1.3, arrowsize=0.8];

  subgraph cluster_data {
    label="Data"; fontsize=16; fontcolor="#777777"; labeljust=l; style=solid; color="#DDDDDD"; margin=12;
    als  [label="ALS point cloud\n(leaf-on)",            fillcolor="#E8F2E0"];
    forc [label="CHS 41 station (1.5 m)\n+ FR-Blo forcing", fillcolor="#DDE8F5"];
    hobo [label="53 HOBO loggers\n(1 m)",                fillcolor="#F7EDE0"];
  }

  subgraph cluster_typ {
    label="Structural typology"; fontsize=16; fontcolor="#777777"; labeljust=l;
    style=solid; color="#DDDDDD"; margin=12;
    traits [label="LiDAR variables (20 m)\nLAI (one-sided) · fCover · Hmax · LAD", fillcolor="#E8F2E0"];
    fpca   [label="FPCA of LAD profiles\n(FPC1–3)",                 fillcolor="#E8F2E0"];
    kmeans [label="k-means typology\n4 archetypes  P1 → P4",        fillcolor="#CDE8CD", color="#1A9850", penwidth=2];
    clhs   [label="cLHS design\n400 real 20 m pixels",              fillcolor="#E8F2E0"];
  }

  musica [label="MuSICA v3.2.3  (iterative ABL)\nΔTmax · buffering slope per plot",
          fillcolor="#DDE8F5", color="#2C6FAD", penwidth=2];

  subgraph cluster_att {
    label="Attribution & validation"; fontsize=16; fontcolor="#777777"; labeljust=l;
    style=solid; color="#DDDDDD"; margin=16;
    attr [label="Variable attribution\nnative steps: LAI ±0.5 (one-sided) · fCover ±10 pts · Hmax ±1 m\nreal vs uniform LAD for the profile",
          fillcolor="#F9E8E8"];
    val  [label="Validation\nloggers · forward inclusion\nmodel-free regression", fillcolor="#F9E8E8"];
  }

  als -> traits;
  traits -> fpca;  traits -> clhs;
  fpca -> kmeans;  kmeans -> clhs;
  clhs -> musica;  forc -> musica;
  musica -> attr;  musica -> val;  hobo -> val;
}
